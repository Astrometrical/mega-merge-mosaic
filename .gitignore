# Rust
/target

# Test data — multi-GB astro panels, never committed
/test_data/

# MMM session caches (tiled panel cache, analysis artifacts)
*.mmm-session/
/sessions/

# Blend outputs in the repo root (runs during development)
/*.fits
/*.tiff
/*.png

# WSL / Windows artifacts
*Zone.Identifier

# Editor
.vscode/
.idea/

# Local cargo overrides (e.g. mpp-core [patch] to the sibling checkout)
/.cargo/config.toml
.superpowers/

# Git worktrees made by Claude Code sessions
/.claude/worktrees/

# The user's voice recordings and voice-clone material: private, never committed
/voice/

# Narration tool output (clips are the voice owner's recordings)
/crates/mmm-app/tours/out/
# any tour output folder, wherever a run lands it (videos and clips are never committed)
**/tours/out/
