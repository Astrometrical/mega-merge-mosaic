# Pinned open-source PCL revision for CI module builds.
# Single source of truth; keep in sync with the OLDEST supported PixInsight core.
#
# Compatibility policy: the module supports PixInsight >= 1.9.0. The PCL static
# lib bakes PCL_API_Version into the module as its declared API requirement,
# and a core refuses any module declaring a newer API than its own — so we
# build against the PCL matching the oldest supported core, and newer cores
# accept it via backward compatibility. Core API history across 1.9.x:
#   1.9.0 initial (PCL 2.8.3)          -> 0x0182
#   1.9.0 update .. 1.9.3 early (2.8.x) -> 0x0183
#   1.9.3 late (PCL 2.9.x)              -> 0x0186
#   1.9.4 (PCL 2.10.x)                  -> 0x0187
#
# gitlab.com/pixinsight/PCL @ this SHA == PCL 2.8.3 / PixInsight 1.9.0 (initial).
PCL_REPO_URL="https://gitlab.com/pixinsight/PCL.git"
PCL_SHA="f1f257d9089bc090d30a319c0a66061c4869b9b2"
PCL_VER_MAJOR=2
PCL_VER_MINOR=8
PCL_VER_RELEASE=3
# Expected `#define PCL_API_Version 0x<hex>` in include/pcl/api/APIInterface.h
# at PCL_SHA. The build-pcl* scripts fail hard on mismatch: shipping a module
# with a too-new API version silently locks out older cores (seen live as
# "Unsupported API version 187 (expected <= 186)" on 1.9.3).
PCL_API_VERSION_HEX=0182

# macOS-arm64-only pin: PCL 2.10.4 / PixInsight 1.9.4 "Lockhart". Pre-2.10.3
# PCL cannot compile for arm64 AT ALL (Defs.h hard-errors "requires an
# x86_64..." and Atomic.h/Math.h use x86 inline asm unconditionally) — arm64
# support arrived with the first arm64 core, 1.9.4. That also makes API
# 0x0187 correct for this target: every arm64 macOS core is >= 1.9.4. All
# other targets (linux-x64, windows-x64, macos-x64) use the 2.8.3 pin above;
# 1.9.0-1.9.3 macOS users run x64 cores (Rosetta on Apple Silicon) and are
# served by the macos-x64 package.
PCL_ARM64_SHA="afea714e681853dfc21e70b5d53811ae41849e97"
PCL_ARM64_VER_MAJOR=2
PCL_ARM64_VER_MINOR=10
PCL_ARM64_VER_RELEASE=4
PCL_ARM64_API_VERSION_HEX=0187
