######################################################################
# MergeMosaic PixInsight module (mmm-pxm) -- Linux/g++/x64 + macOS/clang++/arm64
#
# Flags mirror /opt/PixInsight/src/pcl/<platform>/<compiler>/makefile-*  (the
# flags PixInsight itself builds PCL with: linux/g++/makefile-x64 resp.
# macosx/g++/makefile-arm64). The module links libPCL-pxi.a plus the PCL-free
# host/ objects (used by later tasks; Task 1 only proves they compile into
# the link). Do NOT add -Wl,--no-undefined (Linux) or otherwise strip
# undefined symbols: the module's low-level PixInsight-core symbols are
# resolved by the core at load time, so undefined core symbols in the module
# are expected and correct.
######################################################################

PCLINCDIR ?= /opt/PixInsight/include
PCLLIBDIR ?= $(HOME)/.local/pcl-build/lib
HOSTDIR    = ../host

OBJDIR   = x64/Release

# Platform switch. Only the compiler, module extension and shared-link flag
# are dictated by the port brief verbatim; PLATFORM_CXXFLAGS/PLATFORM_LIBS
# are this makefile's own addition (see note below) so the Darwin branch
# actually compiles and links against PCL rather than just changing the
# output name.
#
# NOTE on CXX: GNU Make ships a built-in default of CXX=g++ (origin
# "default"), and `?=` only assigns when a variable is *undefined* -- a
# built-in default counts as already-defined, so plain `CXX ?= clang++`
# would silently never take effect on Darwin. Guard on `$(origin CXX)` so a
# real user/environment override (`make CXX=...` or `CXX=... make`) still
# wins, but the make-supplied default doesn't block the platform choice.
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
  ifeq ($(origin CXX),default)
    CXX := clang++
  endif
  MODULE_EXT := dylib
  SHARED_FLAGS := -dynamiclib -install_name @rpath/mmm-pxm.dylib
  # PCL's own src/pcl/macosx/g++/makefile-arm64 (pinned SHA) selects Apple
  # code paths off __PCL_MACOSX and builds arm64 with -arch arm64
  # -stdlib=libc++; the Linux branch's -D__PCL_AVX2/-D__PCL_FMA/-mavx2/-mfma/
  # -m64/-minline-all-stringops are GCC-only x86 flags (invalid/unrecognized
  # on clang++ -arch arm64) and -fnon-call-exceptions is a GCC extension
  # clang++ does not recognize, so this branch does not reuse the Linux
  # flags verbatim. macOS has no librt (shm_open etc. are in libc). The
  # three -Wno-* flags mirror PCL's own macosx/g++/makefile-arm64, which
  # needs them to stay warning-free under -Wall when compiling PCL headers
  # with clang++; our module pulls those headers via plain -I (not
  # -isystem), so the same warnings can fire here too.
  PLATFORM_CXXFLAGS := -arch arm64 -mmacosx-version-min=14 -stdlib=libc++ \
                        -D__PCL_MACOSX \
                        -Wno-missing-braces -Wno-nan-infinity-disabled -Wno-extern-c-compat
  # Apple's linker is strict about undefined symbols in a .dylib (unlike GNU
  # ld, which tolerates them in a .so): libPCL-pxi.a alone pulls in
  # CoreFoundation/Foundation/objc (via AppKit) and lcms/lz4/zstd/zlib/
  # RFC6234/cminpack (PCL's own vendored 3rdparty static libs, now built and
  # published alongside libPCL-pxi.a by build-pcl-macos.sh) transitively.
  # -lPCL-pxi must precede the 3rdparty libs it depends on. One
  # `-framework AppKit` resolves all the CF/NS/objc symbols by re-exporting
  # Foundation/CoreFoundation/libobjc -- do not add those individually.
  PLATFORM_LIBS := -framework AppKit -lpthread -lPCL-pxi \
                    -llz4-pxi -lzstd-pxi -lzlib-pxi -lRFC6234-pxi \
                    -llcms-pxi -lcminpack-pxi
else
  ifeq ($(origin CXX),default)
    CXX := g++
  endif
  MODULE_EXT := so
  SHARED_FLAGS := -shared
  PLATFORM_CXXFLAGS := -m64 -D__PCL_LINUX -D__PCL_AVX2 -D__PCL_FMA \
                        -mavx2 -mfma -fnon-call-exceptions -minline-all-stringops
  PLATFORM_LIBS := -lPCL-pxi -lpthread -lrt
endif

TARGET   = mmm-pxm.$(MODULE_EXT)

INCLUDES = -I"$(PCLINCDIR)" -I"$(HOSTDIR)" -I"$(HOSTDIR)/third_party"

CXXFLAGS = -c -pipe -pthread -fPIC \
           -D_REENTRANT $(PLATFORM_CXXFLAGS) \
           -O3 -ffunction-sections -fdata-sections \
           -fvisibility=hidden -fvisibility-inlines-hidden \
           -std=c++20 -Wall -Wno-parentheses

LDFLAGS  = $(SHARED_FLAGS) -fPIC
LIBS     = -L"$(PCLLIBDIR)" $(PLATFORM_LIBS)

MODULE_OBJS = $(OBJDIR)/mmm.o \
              $(OBJDIR)/MmmProcess.o \
              $(OBJDIR)/MmmParameters.o \
              $(OBJDIR)/MmmInterface.o \
              $(OBJDIR)/MmmExecution.o \
              $(OBJDIR)/ViewPanelSource.o \
              $(OBJDIR)/ImageWindowCollector.o \
              $(OBJDIR)/AstrometryProps.o

HOST_OBJS   = $(OBJDIR)/mmm_shm.o \
              $(OBJDIR)/mmm_protocol.o \
              $(OBJDIR)/mmm_host.o

OBJS = $(MODULE_OBJS) $(HOST_OBJS)

.PHONY: all
all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $(TARGET) $(OBJS) $(LIBS)

# --- Code signing (PixInsight >= 1.9 refuses unsigned modules) ---------------
# PixInsight 1.9 removed the "allow unsigned modules" option. For LOCAL
# development you do NOT need a Pleiades certificate: generate a *local signing
# identity* once via the bundled SigningKeys script (tick "Local signing
# identity" -> writes a .xssk keys file tied to your license), then sign the
# module here. That produces mmm-pxm.xsgn beside the .so, which the local core
# trusts. The Pleiades Certified-Developer cert is only needed to distribute to
# OTHER machines (see integration/pixinsight/module/README.md and spec §12).
#
#   make sign XSSK_FILE=$HOME/mmm-dev.xssk XSSK_PASSWORD='your-password'
#
# If PixInsight stays open after signing on your version, adjust SIGN_EXIT.
PIXINSIGHT    ?= PixInsight
XSSK_FILE     ?=
XSSK_PASSWORD ?=
SIGN_EXIT     ?= --force-exit

.PHONY: sign
sign: $(TARGET)
	@test -n "$(XSSK_FILE)" || { \
	  echo "error: set XSSK_FILE=/path/to/your.xssk (generate it via the PixInsight"; \
	  echo "       SigningKeys script with 'Local signing identity' ticked)."; \
	  exit 1; }
	$(PIXINSIGHT) --automation-mode -n \
	  --sign-module-file="$(CURDIR)/$(TARGET)" \
	  --xssk-file="$(XSSK_FILE)" --xssk-password="$(XSSK_PASSWORD)" \
	  $(SIGN_EXIT)
	@test -f "$(CURDIR)/mmm-pxm.xsgn" \
	  && echo "signed: mmm-pxm.xsgn written beside the module" \
	  || echo "note: mmm-pxm.xsgn not found — check the signing output above (flags/password)."

# Module sources (this directory).
$(OBJDIR)/%.o: %.cpp | $(OBJDIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ $<

# Host library sources (../host), compiled into the module link.
$(OBJDIR)/%.o: $(HOSTDIR)/%.cpp | $(OBJDIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ $<

$(OBJDIR):
	mkdir -p $(OBJDIR)

.PHONY: clean
clean:
	rm -f $(OBJS) $(TARGET)
	rm -rf $(OBJDIR)
